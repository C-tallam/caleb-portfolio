# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# MongoDB Atlas connection string (include the database name, e.g. /portfolio)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Port for local development (hosts like Render set this automatically)
PORT=5000

# Long random string (32+ chars) used to sign admin login tokens.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Allowed frontend origin(s), comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173

# Optional
# JWT_EXPIRES_IN=8h
# NODE_ENV=production
